@page
@model GestionProduits.Pages.Produits.IndexModel
@{ ViewData["Title"] = "Produits"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Liste des produits</h1>
        <small class="text-muted">Gérez vos produits simplement.</small>
    </div>
    <a asp-page="Create" class="btn btn-primary">+ Nouveau produit</a>
</div>

@if (Model.Produits.Any())
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>Nom</th>
                        <th>Prix</th>
                        <th>Catégorie</th>
                        <th>Stock</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Produits)
                    {
                        <tr>
                            <td class="fw-semibold">@p.Nom</td>
                            <td>@p.Prix.ToString("N3") DT</td>
                            <td>@p.Categorie?.Nom</td>
                            <td>
                                @if (p.Stock > 0)
                                {
                                    <span class="badge bg-primary">@p.Stock disponible</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Rupture de stock</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Modifier</a>
                                <a asp-page="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-primary text-center py-5">
        <h2 class="h5">Aucun produit</h2>
        <p class="mb-3">Aucun produit n'est disponible pour le moment.</p>
        <a asp-page="Create" class="btn btn-primary">Ajouter un produit</a>
    </div>
}