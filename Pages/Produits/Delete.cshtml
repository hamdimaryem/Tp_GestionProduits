@page "{id:int}"
@model GestionProduits.Pages.Produits.DeleteModel
@{ ViewData["Title"] = "Supprimer"; }

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card" style="border-color:#fecaca;">
            <div class="card-body p-4 text-center">
                <span class="page-header-icon stat-red mb-3" style="width:3.5rem;height:3.5rem;font-size:1.6rem;">
                    <i class="bi bi-trash3"></i>
                </span>
                <h1 class="h4 fw-bold">Supprimer ce produit ?</h1>
                <p class="text-muted">Cette action est irréversible.</p>

                <ul class="list-group list-group-flush text-start mb-4">
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Nom</span>
                        <span class="fw-semibold">@Model.Produit.Nom</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Prix</span>
                        <span class="fw-semibold">@Model.Produit.Prix.ToString("N3") DT</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Catégorie</span>
                        <span class="fw-semibold">@Model.Produit.Categorie?.Nom</span>
                    </li>
                </ul>

                <form method="post" asp-page="Delete" asp-route-id="@Model.Produit.Id"
                      class="d-flex justify-content-center gap-2">
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i>Confirmer la suppression
                    </button>
                    <a asp-page="Index" class="btn btn-outline-secondary">Annuler</a>
                </form>
            </div>
        </div>
    </div>
</div>