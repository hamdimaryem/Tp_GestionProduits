@page "{id:int}"
@model GestionProduits.Pages.Produits.EditModel
@{ ViewData["Title"] = "Modifier le produit"; }

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center gap-3 mb-3">
            <span class="page-header-icon stat-blue"><i class="bi bi-pencil-square"></i></span>
            <div>
                <h1 class="h4 fw-bold mb-0">Modifier le produit</h1>
                <span class="text-muted">Mettez à jour les informations.</span>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-4">
                <form method="post" asp-page="Edit" asp-route-id="@Model.Produit.Id">
                    <input type="hidden" asp-for="Produit.Id" />
                    <div asp-validation-summary="All" class="text-danger mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Produit.Nom" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-tag"></i></span>
                            <input asp-for="Produit.Nom" class="form-control" />
                        </div>
                        <span asp-validation-for="Produit.Nom" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label asp-for="Produit.Prix" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-cash"></i></span>
                                <input asp-for="Produit.Prix" class="form-control" type="number" step="0.001" min="0" />
                                <span class="input-group-text">DT</span>
                            </div>
                            <span asp-validation-for="Produit.Prix" class="text-danger"></span>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label asp-for="Produit.Stock" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-stack"></i></span>
                                <input asp-for="Produit.Stock" class="form-control" type="number" min="0" />
                            </div>
                            <span asp-validation-for="Produit.Stock" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Produit.CategorieId" class="form-label">Catégorie</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-folder2"></i></span>
                            <select asp-for="Produit.CategorieId" asp-items="Model.Categories" class="form-select">
                                <option value="">-- Sélectionner une catégorie --</option>
                            </select>
                        </div>
                        <span asp-validation-for="Produit.CategorieId" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>Enregistrer
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}